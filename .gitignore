# ~/.claude is tool/runtime-owned (plugin installs, Claude Code state, herdr
# hook). Excluded from link-files capture/audit. Root-anchored: common/.claude/
# (tracked context) is unaffected.
/.claude/

# playwright-cli writes page snapshots (.yml) and screenshots (.png) into
# ./.playwright-cli/ relative to the cwd, so running it from a repo checkout
# drops artifacts into that repo. Root-anchored so a nested path of the same
# name is not matched.
/.playwright-cli/
