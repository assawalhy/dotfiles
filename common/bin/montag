#!/usr/bin/env bash
# TODO: collect all options to one ffmpeg command, not more temp files

set -e

print-help () {
    cat <<- EOF
┌──┬─────────────┬───────────────────────────────────────────────────┄┄┄┄┄┄┄┄┄
│-h│ --help      │ Show this help message
│-q│ --quiet     │ See outputs of ffmpeg while processing
│-i│ --input     │ Input video, should have the same extension as [output-video]
│-s│ --start     │ Specifies the start point, e.g. 00:01:23.000 or 83 (in seconds)
│-d│ --duration  │ Duration, length, the same format as start (needs --start)
│-t│ --to        │ End point, the same format as start (needs --start)
│-x│ --speed     │ Speed of the output video (multiplier, e.g., 1.75)
│  │ --yes       │ Work on the video immediately without the user's consent
│  │ --mute      │ Mute audio
│  │ --crop      │ Frame to crop the video, e.g. "in_w:in_h-40", see crop
│  │             │   filter of ffmpeg: http://ffmpeg.org/ffmpeg-filters.html#crop
│  │ --thumb     │ Get a thumbnail of the video or set it by providing a URI for it
├──┼─────────────┼───────────────────────────────────────────────────┄┄┄┄┄┄┄┄┄
│  │ --text      │ Speech to text (convert the audio to text, Whisper will be used)
│  │             │ Default whisper args: --language auto --verbose False --model medium
├──┼─────────────┼───────────────────────────────────────────────────┄┄┄┄┄┄┄┄┄
│  │ --gif       │ Convert to gif, this will set these --fps to 10
│  │ --gif-loop  │ How many loops your gif will do (default false)
│  │ --gif-delay │ How long to delay the gif (default 10)
│  │ --audio     │ Output audio only (works for local files and URLs)
│  │ --split     │ Split output into parts, e.g. 1800 or 00:30:00
├──┼─────────────┼───────────────────────────────────────────────────┄┄┄┄┄┄┄┄┄
│  │ --width     │ Width of the output (aspect ratio is preserved)
│  │ --fps       │ Frames persecond
├──┼─────────────┼───────────────────────────────────────────────────┄┄┄┄┄┄┄┄┄
│-l│ --language  │ Audio language of the track to download, e.g. ar, en-US, pt-BR
│  │ --ytdl      │ yt-dlp additional args
│  │ --ydi       │ yt-dlp interactive mode, requires whiptail
└──┴─────────────┴───────────────────────────────────────────────────┄┄┄┄┄┄┄┄┄

DESCRIPTOIN:
This is a bash script that uses yt-dlp and ffmpeg (and other tools) to facilitate repeated
tasks related to videos and audio, for example I have been using it to download a clip of
a video and make it 1.5x to post it to a social platform (sharing a useful clip)

Another use case it to use it to download only audio with medium quality and split it to 30min parts

USAGE:
  montag -i <input-video> [options...] [-i <input-video> [options...]...] [output-video]

EXAMPLES:
  # get the first 10 seconds and speed up the video two times
  montag -i my-input-video.mp4 --duration 10 --speed 2

  # get the specified range of the video from "--start" to "--to" and speed up
  montag -i my-input-video.mp4 --start 00:10:21 --t 00:11:30 --speed 2
  montag -i my-input-video.mp4 -s 00:10:21 -t 00:11:30 -x 2 --ytdl "-u username -p password"

  # cut a part of the video in a specific dubbed audio language
  montag -i <uri> -s 00:10:00 -d 300 --language ar lecture3-ar.mp4

  # get a transcription of a part of a video
  montag -i <uri> -s 00:10:11 -d 30 --text --whisper "--language auto" | clip

  # download/process only audio (with clipping/speed if needed)
  montag -i <uri> --audio -s 00:01:00 -d 120 -x 1.25 my-audio.mp3

  # split output into 30-minute parts
  montag -i <uri> --audio --split 00:30:00 podcast.mp3

NOTES:
  A video given as a URL is read by ffmpeg itself: yt-dlp only resolves the
  stream urls and the headers they need, then ffmpeg seeks with HTTP range
  requests and cuts the clip in the same pass that encodes it.

  When --split is used, parts are written under "<output-name>/<output-name>_NNN.<ext>".
  
  If you want to extract the text from the video or the audio it will be whisper at the end
  so that downloading step scenarios is the same as described before.
EOF
}

collect-arg-and-validate() {
    while (($#)); do
        arg=$1; shift
        case "$arg" in
            -q|--quiet) is_quiet=1 ;;
            -h|--help) is_help=1 ;;
            --yes) is_yes=1 ;;
            --mute) mute_audio=1 ;;
            --ydi) is_ydi=1 ;;
            --ytdl) ytdl_options=("$1") && shift ;; # TODO: how to parse arguments with spaces
            --input|-i) input="$1"; shift ;;
            --language|-l) language="$1"; shift ;;
            --start|-s) start_point="$1"; shift ;;
            --duration|-d) duration="$1"; shift ;;
            --to|-t) end_point="$1"; shift ;;
            --speed|-x) speed="$1"; shift ;;
            --crop) crop="$1"; shift ;;
            --width) width="$1"; shift ;;
            --fps) fps="$1"; shift ;;
            --thumb)
                is_thumb=1
                [ $# = 0 ] || [[ "$1" = -* ]] && continue;
                thumb="$1"; shift ;;
            --gif) is_gif=1 ;;
            --gif-loop) gif_loop="$1"; shift ;;
            --gif-delay) gif_delay="$1"; shift ;;
            --audio|--audio-only) is_audio_only=1 ;;
            --split) split_period="$1"; shift ;;

            --text) is_text=1 ;;

            *)
                if [[ "$arg" = -* ]] || (($#))
                then
                    echo-debug error: invalid arguments
                    exit 2
                fi
                output="$arg"
                is_output_explicit=1
                ;;
        esac
    done

    ((is_help)) && print-help && exit 0

    # ----- cutting -----

    if [ "$end_point" ] && [ "$duration" ]; then
        echo-debug error\(cutting\): both end point and duration are provided
        exit 2
    fi

    if [ "$end_point" ] || [ "$duration" ]; then
        start_point=$([ "$start_point" ] && echo "$start_point" || echo "00:00:00")
    fi

    # ----- giffing -----

    if [ "$loop" ] && [ ! "$is_gif" ]; then
        echo-debug error\(giffing\): can\'t use --loop without --gif
        exit 2
    fi

    # ---- text ----
    if [ "$is_text" ] && [ ! -d ~/bin/montag2 ]; then
        echo-debug error\(text\): can\'t find the whisper model in ~/bin/montag2
        read -r -p "do you want to get it? ([Y]/n): " ans
        ans="$(echo "$ans" | tr '[:upper:]' '[:lower:]')"
        [ "$ans" = "y" ] || [ -z "$ans" ] || clear-and-exit 1
        print-and-run-cmd mkdir -p "$HOME/.local/share/montag"
        print-and-run-cmd cd "$HOME/.local/share/montag"
        print-and-run-cmd python3 -m venv env
        print-and-run-cmd source env/bin/activate
        print-and-run-cmd pip install git+https://github.com/openai/whisper.git
    fi

    if [ "$is_text" ] && [ "$split_period" ]; then
        echo-debug error\(text\): --text can\'t be used with --split
        exit 2
    fi

    # ---- language ----
    # the code lands in an unquoted yt-dlp argument, so reject anything that is
    # not a plain code before it can inject filter syntax
    if [ "$language" ] && ! is-language-code "$language"; then
        echo-debug error\(language\): invalid language code "[$language]"
        exit 2
    fi

    # ----- IO -----

    prepare-input-and-output
}

echo-debug() {
    [ "$is_quiet" ] || >&2 echo "=>" "$@"
}

echo-info() {
    >&2 echo "->" "$@"
}

add-quotes() {
    local quoted_args=()
    for arg in "$@"; do
        quoted_args+=("\"$arg\"")
    done
    echo "${quoted_args[@]}"
}

print-cmd() {
    for arg in "$@"; do
        if [[ "$arg" == "||" || "$arg" == "&&" || "$arg" == "|" || "$arg" == "&" || "$arg" == ";" || "$arg" == ">" || "$arg" == "<" ]]; then
            echo -n "$arg "
            continue
        fi
        
        # Check if argument contains characters that need escaping
        if [[ "$arg" =~ [][{}\(\)\\\*\?~\`\$\#\=\!\|\&\;\<\>\'\"] ]] || [[ "$arg" =~ [[:space:]] ]]; then
            arg="'$(echo "$arg" | sed "s/'/'\\\\''/g")'"
        fi
        
        echo -n "$arg "
    done
    echo
}

print-and-run-cmd() {
    local quoted="$(print-cmd "$@")"
    echo-debug "$quoted"
    # eval runs the assembled string, so pipes and && chains work in it
    eval "$quoted"
}

# The height the format selectors cap at: the default sort and --language read
# the same variable so the two cannot drift apart.
default_resolution=720

# yt-dlp language codes are two or three letters, optionally with a region.
is-language-code() { # code
    [[ "$1" =~ ^[A-Za-z]{2,3}(-[A-Za-z]{2,4})?$ ]]
}

# yt-dlp format selector for one audio language. h264 video with an m4a audio
# track is the pair the mp4 encode is fastest with; the second alternative covers
# a video with no h264 stream, or no m4a track, in that language. There is no
# fallback to the original language: a clip in the wrong language is worse than
# an error.
build-language-format() { # language media(video|audio)
    if [ "$2" = audio ]; then
        echo "bestaudio[language=$1][abr<=128k]"
    else
        echo "bv*[height<=$default_resolution][ext=mp4][vcodec^=avc1]+ba[language=$1][ext=m4a]/bv*[height<=$default_resolution]+ba[language=$1]"
    fi
}

# The codecs each policed container accepts with -c copy. Measured on ffmpeg
# 8.1.2 by remuxing one mkv per codec into each container: mp4 takes vp9 and
# av1 but not vp8, mov takes neither vp9 nor opus, and the ipod muxer behind
# m4v only takes h264, mpeg4 and the audio of the mp4 group. Every other
# container is not policed and returns 0.
container-allows-codec() { # container codec
    case "$1" in
        mp4)
            case "$2" in
                h264|hevc|mpeg4|mjpeg|vp9|av1|aac|mp3|ac3|flac|opus|vorbis) return 0 ;;
                *) return 1 ;;
            esac ;;
        mov)
            case "$2" in
                h264|hevc|mpeg4|mjpeg|aac|mp3|ac3|vorbis) return 0 ;;
                *) return 1 ;;
            esac ;;
        m4v)
            case "$2" in
                h264|mpeg4|aac|mp3|ac3) return 0 ;;
                *) return 1 ;;
            esac ;;
        webm)
            case "$2" in
                vp8|vp9|av1|opus|vorbis) return 0 ;;
                *) return 1 ;;
            esac ;;
        *) return 0 ;;
    esac
}

# The codec names of every stream in one input, one per line. A failing probe
# prints nothing, so the caller can keep the copy instead of guessing.
input-codecs() { # ffprobe args ending in the input
    ffprobe -v error -show_entries stream=codec_name \
        -of default=noprint_wrappers=1:nokey=1 "$@" 2>/dev/null || true
}

# A stream copy only works when the output muxer has a tag for every input
# codec. Sets copy_blocker to the reason when it refuses, so the re-encode
# branch can say why it is about to encode instead of copying.
can-stream-copy() {
    copy_blocker=''

    local container="$(echo "${output_target##*.}" | tr '[:upper:]' '[:lower:]')"
    case "$container" in
        mp4|mov|m4v|webm) : ;;
        *) return 0 ;;
    esac

    local probe_args=()
    if [[ "$input" =~ ^https?:// ]]; then
        probe_args=(-request_size "$http_request_size")
        [ ! "$ua" ] || probe_args=(-user_agent "$ua" "${probe_args[@]}")
    fi

    local inputs=()
    if [[ "$input" =~ ^https?:// ]]; then
        inputs=("${input_urls[@]}")
    else
        inputs=("$input")
    fi

    local source codes codec
    for source in "${inputs[@]}"; do
        codes="$(input-codecs "${probe_args[@]}" "$source")"
        [ "$codes" ] || return 0
        while IFS= read -r codec; do
            [ "$codec" ] || continue
            if ! container-allows-codec "$container" "$codec"; then
                copy_blocker="$codec is not allowed in $container"
                return 1
            fi
        done <<< "$codes"
    done

    return 0
}

# The codes the video offers, for the error when the requested one is not there.
# yt-dlp -F tags every dubbed or subtitled track with its code.
list-language-codes() { # url
    local codes
    codes="$(yt-dlp "${ytdl_options[@]}" --no-playlist -F "$1" 2>/dev/null \
        | grep -oE '\[[A-Za-z]{2,3}(-[A-Za-z]{2,4})?\]' | tr -d '[]' | sort -u | tr '\n' ' ')"
    [ "$codes" ] || codes='none listed'
    echo "$codes"
}

# Parse the marked lines of the resolver call. Sets resolved_title, input_urls
# and ua, and fails when no stream url came back.
parse-resolver-output() { # text
    local line rest
    resolved_title=''
    input_urls=()
    ua=''

    while IFS= read -r line; do
        rest="${line#MONTAG-}"
        case "$rest" in
            TITLE:*) resolved_title="${rest#TITLE:}" ;;
            URL:NA|URL:) : ;;
            URL:*) input_urls+=("${rest#URL:}") ;;
            HDR:*) [ "$rest" = HDR:NA ] || [ -n "$ua" ] \
                || ua="$(printf '%s' "${rest#HDR:}" | sed -n 's/.*"User-Agent": *"\([^"]*\)".*/\1/p')" ;;
        esac
    done <<< "$1"

    [ ${#input_urls[@]} -gt 0 ]
}

# yt-dlp resolves the title, the stream urls and the headers those urls need.
# The media itself is never downloaded by yt-dlp: ffmpeg reads the urls, seeks
# into them and encodes once.
resolve-url-input() { # url
    resolved_title=''
    input_urls=()
    ua=''

    echo-debug "🔗 ... resolve the url with yt-dlp"
    parse-resolver-output "$(yt-dlp "${ytdl_options[@]}" --no-playlist \
        -O 'MONTAG-TITLE:%(title)s.%(ext)s' \
        -O 'MONTAG-URL:%(requested_formats.0.url)s' \
        -O 'MONTAG-URL:%(requested_formats.1.url)s' \
        -O 'MONTAG-URL:%(url)s' \
        -O 'MONTAG-HDR:%(requested_formats.0.http_headers)j' \
        -O 'MONTAG-HDR:%(http_headers)j' "$1")"
}

temp_files=()

# ffmpeg reads a googlevideo url at about 67 KB/s with one long request and at
# 619 KB/s once the reads are split into 1 MB range requests.
http_request_size=1048576

get-temp-file() {
    mkdir -p /tmp/montag
    file=/tmp/montag/"$RANDOM.$1"
    temp_files+=("$file")
    echo "$file"
}

prepare-input-and-output() {
    [ ! "$input" ] && echo-debug error\(IO\): input file is required && exit 2

    if [[ "$input" =~ ^https?:// ]]; then
        if [ "$is_ydi" ]; then
            read -ra quality_settings < <(print-and-run-cmd ydi -p "$input")
            ytdl_options+=("${quality_settings[@]}")
        fi

        # --language owns -f, so it cannot be combined with the other two ways
        # of setting one. Both come last in the argv and would win silently.
        if [ "$language" ]; then
            if [ "$is_ydi" ]; then
                echo-debug error\(language\): --language and --ydi both set the format
                exit 2
            fi
            if [[ " ${ytdl_options[*]} " =~ (^|[[:space:]])-f ]]; then
                echo-debug error\(language\): --language and the -f in --ytdl both set the format
                exit 2
            fi

            if [ "$is_text" ] || [ "$is_audio_only" ]; then
                media=audio
            else
                media=video
            fi
            ytdl_options+=(-f "$(build-language-format "$language" "$media")")
            echo-debug "🌐 ... audio language set to $language"
        elif [ ${#ytdl_options[@]} = 0 ]; then
            if [ "$is_text" ]; then
                ytdl_options+=(-f 'bestaudio[abr<=128k]' --extract-audio --audio-format mp3 --audio-quality 5)
            elif [ "$is_audio_only" ]; then
                ytdl_options+=(-f 'bestaudio[abr<=128k]')
            else
                # Progressive formats that combine video and audio are gone
                # from YouTube. -S picks separate streams and yt-dlp merges them.
                ytdl_options+=(-S "res:$default_resolution")
            fi
        fi

        # In quiet mode add --no-warnings and --no-progress to yt-dlp, but not
        # --quiet, so errors still appear. Flags already present are skipped.
        if [ "$is_quiet" ]; then
            for _flag in --no-warnings --no-progress; do
                case " ${ytdl_options[*]} " in
                    *" ${_flag} "*) : ;; # already present
                    *) ytdl_options+=("${_flag}") ;;
                esac
            done
        fi

        # --thumb without a value asks yt-dlp to write the thumbnail itself,
        # so no media stream has to be resolved in that case.
        needs_streams=true
        [ "$is_thumb" ] && [ ! "$thumb" ] && needs_streams=false

        if [ "$needs_streams" ]; then
            resolve-url-input "$input" || {
                if [ "$language" ]; then
                    echo-debug "error: no audio track in language [$language], this video offers: $(list-language-codes "$input")"
                else
                    echo-debug 'error: yt-dlp did not return a stream url'
                fi
                clear-and-exit 1
            }
            [ "$output" ] || output="${resolved_title/\//_}"
        fi
    elif [ "$language" ]; then
        echo-debug error\(language\): --language needs a URL input
        exit 2
    elif [ ! "$output" ]; then
        # the extension matches the input; the base name gains a -montaged suffix
        output="$(echo "$input" | sed -e 's/^\(.*\)\.\(.*\)$/\1-montaged.\2/')"
    fi

    if [ "$is_gif" ]; then
        output="${output%.*}.gif"
    elif [ "$is_audio_only" ] && [ ! "$is_output_explicit" ]; then
        output="${output%.*}.mp3"
    fi
}

get-input-args() {
    set -e
    local argv=("$@")
    local input="${argv[-1]}"
    unset 'argv[-1]'

    if [[ "$input" =~ ^https?:// ]] && { [ ! "$is_thumb" ] || [ "$thumb" ]; }; then
        # ffmpeg must present the User-Agent yt-dlp used, and it reads far
        # slower without -request_size: 67 KB/s became 619 KB/s on YouTube.
        local http_args=(-request_size "$http_request_size")
        [ "$ua" ] && http_args=(-user_agent "$ua" "${http_args[@]}")

        local url
        for url in "${input_urls[@]}"; do
            cmd+=("${argv[@]}" "${http_args[@]}" -i "$url")
        done

        # the thumbnail is appended as its own input, then every input is mapped
        if [ "$thumb" ]; then
            cmd+=(-i "$thumb")
            local index
            for ((index = 0; index < ${#input_urls[@]}; index++)); do
                cmd+=(-map "$index")
            done
            cmd+=(-map "${#input_urls[@]}" -c copy -disposition:v:1 attached_pic)
        fi
        return 0
    fi

    # a local input needs -i: -t and -to before a bare path would make ffmpeg
    # read that path as the output file
    cmd+=("${argv[@]}" -i "$input")
}

get-final-cmd() {
    if [[ ${#convert_cmd[@]} -gt 1 ]]; then
        echo "$(print-cmd "${cmd[@]::${#cmd[@]}-1}" "|" "${convert_cmd[@]}" "$output")"
    elif [[ ${#whisper_cmd[@]} -gt 1 ]]; then
        echo "$(print-cmd "${cmd[@]}" "&&" "${whisper_cmd[@]}")"
    else
        echo "$(print-cmd "${cmd[@]}")"
    fi
}

get-user-acceptance() {
    [ "$is_yes" ] && return
    echo-info
    echo-info "👇 This is the final command"
    echo-info "$final_cmd"
    echo-info

    read -r -p "continue ? ([Y]/n): " ans
    ans="$(echo "$ans" | tr '[:upper:]' '[:lower:]')"
    [ "$ans" = "y" ] || [ -z "$ans" ] || clear-and-exit 1
}

clear-and-exit() {
    for file in "${temp_files[@]}"; do rm -rf "$file"; done
    exit_code="${1:-0}"
    exit "$exit_code"
}

# libx264 needs an even width and height and a screen recording is often odd
# in one of them, so the re-encode branch appends this to the -vf it already
# has. ffmpeg keeps only the last -vf argument, hence the index.
append-even-scale-filter() {
    local scale='scale=trunc(iw/2)*2:trunc(ih/2)*2'
    if [ "$video_filter_arg_index" ]; then
        cmd[$video_filter_arg_index]="${cmd[$video_filter_arg_index]},$scale"
    else
        cmd+=(-vf "$scale")
        video_filter_arg_index=$((${#cmd[@]} - 1))
    fi
}

build-ffmpeg-command() {
    cmd=(ffmpeg)
    convert_cmd=(convert)
    whisper_cmd=(whisper)
    video_filters=()
    audio_filters=()
    output_target="$output"

    # Quiet logs
    [ "$is_quiet" ] && cmd+=(-loglevel error)

    # Cut (Slice)
    if [ "$start_point" ]; then
        extra_description=$([ "$duration"  ] && echo "with length $duration" || echo "to $end_point")
        echo-debug "✂️  ... cut part of the video from $start_point $extra_description"

        cut_args=(-ss "$start_point")
        [ "$duration"  ] && cut_args+=(-t "$duration")
        [ "$end_point" ] && cut_args+=(-to "$end_point")

        get-input-args "${cut_args[@]}" "$input"
    else
        get-input-args "$input"
    fi

    # Speed
    if [ "$speed" ]; then
        echo-debug "⏩️  ... speedup the cut video x$speed"
        [ ! "$is_audio_only" ] && video_filters+=("setpts=PTS/$speed")
        [ ! "$mute_audio" ] && audio_filters+=("atempo=$speed")
    fi

    # Crop
    if [ "$crop" ]; then
        [ "$is_audio_only" ] && echo-debug "error: --crop can\'t be used with --audio" && exit 2
        echo-debug "🖼️  ... crop the video with $crop"
        video_filters+=("crop=$crop")
    fi

    # a later -vf replaces an earlier one, so the even size scale of the
    # re-encode branch is appended to this argument once the branch runs
    video_filter_arg_index=''
    if [ "${#video_filters[@]}" -gt 0 ]; then
        cmd+=(-vf "$(IFS=,; echo "${video_filters[*]}")")
        video_filter_arg_index=$((${#cmd[@]} - 1))
    fi
    if [ "${#audio_filters[@]}" -gt 0 ]; then
        cmd+=(-af "$(IFS=,; echo "${audio_filters[*]}")")
    fi

    # Mute audio
    if [ "$mute_audio" ]; then
        echo-debug "🔇 ... mute the audio"
        cmd+=(-an)
    fi

    if [ "$is_audio_only" ]; then
        echo-debug "🎵 ... output audio only"
        cmd+=(-vn -c:a mp3 -b:a 128k)
    fi

    exclusive=0

    if [ "$is_thumb" ]; then
        if [ -n "$thumb" ]
        then
            echo-debug "🖼️  ... use '$thumb' as thumbnail"
        else
            [ "$exclusive" = 1 ] && echo-debug "error: you using two options together like --gif --thumb" && exit 1
            exclusive=1
            echo-debug "🖼️  ... generate thumbnail"
            cmd=(yt-dlp --skip-download --write-thumbnail --convert-thumbnails jpg "${ytdl_options[@]}" "$input")
        fi
    fi

    # GIF conversion
    if [ "$is_gif" ]; then
        [ "$is_audio_only" ] && echo-debug "error: --gif can\'t be used with --audio" && exit 1
        [ "$split_period" ] && echo-debug "error: --gif can\'t be used with --split" && exit 1
        [ "$exclusive" = 1 ] && echo-debug "error: you using two options together like --gif --thumb" && exit 1
        exclusive=1
        echo-debug 📽️ ... generating a gif
        fps=$((fps || 10))
        lloop=$((gif_loop || 0))
        ldelay=$((gif_delay || 10))
        cmd+=(-vf "fps=${fps}${width:+,scale=$width:-1:flags=lanczos}" -c:v pam -f image2pipe -)
        convert_cmd+=(-delay "$ldelay" - -loop "$lloop" -layers optimize)
    fi

    if [ "$is_text" ]; then
        [ "$exclusive" = 1 ] && echo-debug "error: you using two options together like --gif --thumb" && exit 1
        exclusive=1
        echo-debug "🗣️  ... convert the video to text"
        output="$(get-temp-file "$(basename "$output")")"
        output_target="$output" # whisper reads what ffmpeg writes
        whisper_cmd+=("$output" --verbose False --model medium --output_format txt --output_dir "$(dirname "$output")")
    fi

    # No filters and no cuts: use stream copy (-c copy) instead of re-encoding
    if [ "${cmd[0]}" = ffmpeg ] && [ ! "$start_point" ] \
        && [ ${#video_filters[@]} -eq 0 ] && [ ${#audio_filters[@]} -eq 0 ] \
        && [ ! "$mute_audio" ] && [ ! "$is_audio_only" ] && [ ! "$is_gif" ] \
        && [ ! "$is_text" ] && [ ! "$is_thumb" ] && can-stream-copy; then
        echo-debug "📼 ... no filters or cuts, stream copy"
        cmd+=(-c copy)
    elif [ "${cmd[0]}" = ffmpeg ] && [ ! "$is_audio_only" ] \
        && [ ! "$is_gif" ] && [ ! "$is_thumb" ]; then
        [ ! "$copy_blocker" ] || echo-debug "🔁 ... $copy_blocker, so no stream copy"
        # Re-encoding: faster settings for the container. libvpx-vp9 without
        # -row-mt is single thread bound (0.6x realtime on 12 threads) and
        # libx264 medium is about 10x slower than veryfast. libx264, mpeg4 and
        # mpeg2video all refuse an odd width or height, which a screen
        # recording easily has, so every re-encode gets the even size scale.
        case "$output_target" in
            *.webm)
                echo-debug "🔧 ... encode vp9 with -row-mt 1 -cpu-used 4"
                cmd+=(-c:v libvpx-vp9 -row-mt 1 -cpu-used 4 -pix_fmt yuv420p)
                ;;
            *.mp4|*.mov|*.m4v)
                echo-debug "🔧 ... encode x264 with -preset veryfast -crf 23"
                cmd+=(-c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p)
                # the moov atom at the front lets a browser play the file
                # before the whole download finished
                cmd+=(-movflags +faststart)
                ;;
            *)
                # mkv, avi and ts have no tuned branch: ffmpeg picks its
                # default encoder, which also needs an even frame size
                echo-debug "🔧 ... keep the ffmpeg default encoder for this container"
                cmd+=(-pix_fmt yuv420p)
                ;;
        esac
        append-even-scale-filter
    fi

    if [ "$split_period" ] && [ "${cmd[0]}" = ffmpeg ]; then
        output_dir="$(dirname "$output")"
        output_name="$(basename "$output")"
        if [[ "$output_name" == *.* ]]; then
            split_base="${output_name%.*}"
            split_ext=".${output_name##*.}"
        else
            split_base="$output_name"
            split_ext=""
        fi
        split_dir="${output_dir}/${split_base}"
        mkdir -p "$split_dir"
        output_target="${split_dir}/${split_base}_%03d${split_ext}"
        echo-debug "🧩 ... split output every ${split_period} into ${split_dir}"
        cmd+=(-f segment -segment_time "$split_period" -reset_timestamps 1 "$output_target")
    elif [ "${cmd[0]}" = ffmpeg ]; then
        cmd+=("$output_target")
    fi

    final_cmd="$(get-final-cmd)"
    get-user-acceptance

    if [[ ${#whisper_cmd[@]} -gt 1 ]]; then
        "${cmd[@]}"
        dir="$PWD"
        cd ~/bin/montag2
        source env/bin/activate

        if ! which whisper > /dev/null; then
            echo-debug "error: you should install whisper first"
            clear-and-exit 1
        fi

        eval "${whisper_cmd[@]}"
        cat "${output%.*}.txt"

        cd "$dir"
    else
        eval "$final_cmd"
    fi
}

collect-arg-and-validate "$@"
build-ffmpeg-command
clear-and-exit 0
