#!/usr/bin/env bash
# git textconv entry point: turn any non-text blob in $1 into something a diff
# can show. Rendering, text extraction and the typed placeholder all live in
# file-preview; this only picks the raw mode so the pager's delta child is the
# only thing that styles text. git passes the blob as a temp file that keeps the
# original basename, so file-preview can classify it by extension.
set -u

file="${1:-}"
if [ -z "$file" ] || [ ! -f "$file" ]; then
    exit 0
fi

exec file-preview --raw "$file"
