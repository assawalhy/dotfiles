#!/usr/bin/env bash
# lazygit helper: render a file's diff in the real terminal (custom command
# with `output: terminal`, so lazygit suspends and the images actually show).
# Non-text files go through git-img-pager; with no diff at all (untracked or
# unchanged) the file itself is shown through file-preview, which renders,
# extracts text, or prints a typed placeholder.
set -u

path="${1:-}"
if [ -z "$path" ]; then
    echo "usage: git-img-preview <path>" >&2
    exit 2
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "not a git repository" >&2
    exit 1
fi

diff=$(git --no-pager diff HEAD -- "$path")

if [ -n "$diff" ]; then
    printf '%s\n' "$diff" | git-img-pager
    exit 0
fi

if [ -f "$path" ]; then
    file-preview "$path"
    exit 0
fi

echo "nothing to preview for $path"
exit 0
