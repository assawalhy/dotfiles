#!/usr/bin/env bash
# lazygit helper: render a file's diff in the real terminal (custom command
# with `output: terminal`, so lazygit suspends and the images actually show).
# Images go through git-img-pager; non-images fall back to a plain text diff.
# With no diff at all (untracked or unchanged), the file itself is shown.

set -u

path="${1:-}"
if [ -z "$path" ]; then
    echo "usage: git-img-preview <path>" >&2
    exit 2
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "not a git repository" >&2
    exit 1
fi

diff=$(git --no-pager diff HEAD -- "$path")

if [ -n "$diff" ]; then
    printf '%s\n' "$diff" | git-img-pager
    exit 0
fi

if [ -f "$path" ]; then
    # Untracked or unchanged: show the file itself (images inline, text via delta).
    case "$path" in
        *.png|*.PNG|*.jpg|*.JPG|*.jpeg|*.JPEG|*.gif|*.GIF|*.webp|*.WEBP|*.bmp|*.BMP|*.tiff|*.TIFF|*.tif|*.TIF|*.avif|*.AVIF|*.heic|*.HEIC)
            git-img-textconv "$path"
            ;;
        *)
            delta --paging=never < "$path" 2>/dev/null || cat "$path"
            ;;
    esac
    exit 0
fi

echo "nothing to preview for $path"
exit 0
