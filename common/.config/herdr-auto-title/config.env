# Auto Title (kryptamine/herdr-auto-title) configuration.
#
# Auto Title reads this file once at startup, so restart it after a change:
#   herdr plugin action invoke herdr.auto-title.restart   (or prefix+R)
# Every value below is the plugin default; the remaining knobs are documented
# in the plugin README (max length, poll interval, pane ids, ...).

# Tab position in front of the title (off: the tab strip already numbers them).
HERDR_AUTO_TITLE_POSITION=false

# Longest branch a title may carry, in columns. 0 leaves branches out.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# Read an agent's session transcript when it has not titled its terminal.
HERDR_AUTO_TITLE_TRANSCRIPT=true

# Put the agent's name in front of what an agent pane is doing.
HERDR_AUTO_TITLE_AGENT_NAME=true

# Name each pane as well as its tab (what herdr's goto panel lists).
HERDR_AUTO_TITLE_PANES=true

# Report each workspace's active-tab topic (needs a $topic sidebar row).
HERDR_AUTO_TITLE_WORKSPACES=true
