[include]
    path = ~/.config/delta/themes.gitconfig
    # platform-specific bits (gpg program, credential helper) -- linked from
    # the linux/ or macos/ overlay. Git silently ignores a missing include.
    path = ~/.config/git/os.gitconfig

[alias]
    s = status
    co = checkout
    cb = checkout -b
    br = branch
    ll = log --oneline
    lg = log --pretty=format:"%C(yellow)%h%Creset %C(green)%s%Creset %Cred%d%Creset %Cblue[%an]" --date=short
    cm = commit -m
    can = commit --amend --no-edit
    cam = commit --amend -m
    conflicted = !vim +Conflicted

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[core]
    # git-img-pager pipes text through delta and writes image escapes straight
    # to the terminal -- delta drops them (dandavison/delta#1399). The
    # fallback keeps diffs working on machines without python3.
    pager = git-img-pager || delta --paging=never
    excludesFile = ~/.gitignore_global
    attributesFile = ~/.config/git/attributes

[interactive]
    diffFilter = delta --color-only


[core]
  whitespace = error
  preloadindex = true

[pager]
  diff = git-img-pager || delta --paging=never
  log = git-img-pager || delta --paging=never
  reflog = git-img-pager || delta --paging=never
  show = git-img-pager || delta --paging=never

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[delta]
    side-by-side = false
    navigate = true  # use n and N to move between diff sections
    line-numbers = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

# Raster images are diffed as inline-image escapes (see git-img-textconv and
# git-img-pager); the attribute globs live in ~/.config/git/attributes.
[diff "img"]
    textconv = git-img-textconv
