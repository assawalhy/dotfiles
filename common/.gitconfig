[include]
    path = ~/.config/delta/themes.gitconfig
    # platform-specific bits (gpg program, credential helper) -- linked from
    # the linux/ or macos/ overlay. Git silently ignores a missing include.
    path = ~/.config/git/os.gitconfig

[alias]
    s = status
    co = checkout
    cb = checkout -b
    mr = merge
    ms = merge --squash
    mnff = merge --no-ff
    br = branch
    ll = log --oneline
    lg = log --pretty=format:"%C(yellow)%h%Creset %C(green)%s%Creset %Cred%d%Creset %Cblue[%an]" --date=short
    cm = commit -m
    cam = commit -am
    csm = commit -S -m
    csam = commit -S -am
    ca = commit --amend --no-edit
    cma = commit --amend -m
    cama = commit --amend -am
    csma = commit --amend -S -m
    casma = commit --amend -S -am
    conflicted = !vim +Conflicted

[user]
    email = muhammadsawalhy@gmail.com
    name = Assawalhy
    username = assawalhy

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[core]
    pager = delta
    excludesFile = ~/.gitignore_global

[interactive]
    diffFilter = delta --color-only


[core]
  whitespace = error
  preloadindex = true

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[delta]
    side-by-side = false
    navigate = true  # use n and N to move between diff sections
    line-numbers = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
