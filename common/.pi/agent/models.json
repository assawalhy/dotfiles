{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "runanywhere": {
      "name": "RunAnywhere",
      "baseUrl": "https://inference.runanywhere.ai/v1",
      "api": "openai-completions",
      "apiKey": "!cat $HOME/.secrets/runanywhere-api-key",
      "models": [
        {
          "id": "glm-5.3-flash",
          "name": "GLM 5.3 Flash",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          },
          "input": ["text", "image"],
          "cost": {
            "input": 0.1,
            "output": 0.35,
            "cacheRead": 0.02,
            "cacheWrite": 0
          },
          "contextWindow": 1048576,
          "maxTokens": 131072,
          "compat": {
            "thinkingFormat": "openai",
            "supportsReasoningEffort": true,
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "maxTokensField": "max_tokens"
          }
        },
        {
          "id": "deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "input": ["text", "image"],
          "cost": {
            "input": 0.2,
            "output": 0.6,
            "cacheRead": 0.006,
            "cacheWrite": 0
          },
          "contextWindow": 1048576,
          "maxTokens": 262144,
          "compat": {
            "thinkingFormat": "openai",
            "supportsReasoningEffort": true,
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "maxTokensField": "max_tokens"
          }
        }
      ]
    }
  }
}
