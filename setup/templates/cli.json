{
  "$schema": "https://opencode.ai/v2/cli.json",
  "prompt": {
    "image_preview": true
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "session": {
    "scrollbar": true,
    "image_preview": true,
    "new_location": "launch",
    "sidebar": "hide"
  },
  "tabs": {
    "scope": "cwd",
    "layout": "horizontal",
    "mode": "auto"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "notifications": false,
    "sound": false
  }
}
